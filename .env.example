# ============================================================
# Firebase Configuration (Client-side - NEXT_PUBLIC_*)
# Get these from your Firebase Project Settings
# REQUIRED for authentication to work
# ============================================================

# Your Firebase project's API key
# Found in: Firebase Console > Project Settings > General > Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key

# Your Firebase authentication domain
# Default: your-project-id.firebaseapp.com
# Found in: Firebase Console > Project Settings > General > Web API Key section
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Your Firebase project ID
# Found in: Firebase Console > Project Settings > General > Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Your Firebase storage bucket
# Default: your-project-id.appspot.com
# Found in: Firebase Console > Project Settings > Storage > Files > Get Started
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase messaging sender ID (for push notifications)
# Found in: Firebase Console > Project Settings > General > Web app configuration
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase app ID
# Found in: Firebase Console > Project Settings > General > Web app configuration
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Firebase measurement ID (for Google Analytics)
# Found in: Firebase Console > Project Settings > Integrations > Google Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# Application URL (Client-side)
# ============================================================

# Your app's base URL
# Used for OAuth redirects and API callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Database Configuration (Server-side)
# ============================================================

# PostgreSQL connection string
# For Neon: postgresql://user:password@hostname:5432/database?sslmode=require
# For local: postgresql://postgres:password@localhost:5432/energyos
DATABASE_URL=postgresql://user:password@localhost:5432/energyos

# Optional: Require strict SSL in production
# Set to "true" for production Neon connections
DATABASE_SSL_STRICT=false

# Optional: Path to custom CA certificate for SSL
# Only needed if using self-signed certificates
# DATABASE_SSL_CA_PATH=/path/to/ca.pem

# ============================================================
# Cloudinary Configuration
# ============================================================

# Get these from Cloudinary Dashboard > Settings > General
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Cloudinary API credentials (server-side only)
# Found in: Cloudinary Dashboard > Settings > Security > API Key/Secret
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# Resend Configuration (Email services)
# ============================================================

# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxx

# Sender email address for your app
# Found in: Resend Dashboard > Domains or API Settings
RESEND_FROM_EMAIL=onboarding@energyos.com

# ============================================================
# Authentication Options
# ============================================================

# Require email verification before allowing login
# Set to "true" to enforce verified email addresses (production only)
AUTH_ENFORCE_VERIFIED=false

# Allow unverified users (for development/testing)
# Set to "false" in production for security
AUTH_ALLOW_UNVERIFIED=true

# ============================================================
# Development Bypass (ONLY for development)
# ============================================================

# Enable development auth bypass (dev-only, requires DEV_AUTH_BYPASS=true AND DEV_PROFILE_ID=xxx)
# WARNING: Cannot be enabled in production! This is a security feature.
DEV_AUTH_BYPASS=false

# A valid profile ID for testing when dev bypass is enabled
# Can be any UUID - will be converted to valid profile ID format
DEV_PROFILE_ID=test-profile-id-here

# ============================================================
# Cron/Automation Secrets
# ============================================================

# Secret for protecting cron jobs
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Scheduler secret for reminder API (separate from cron secret)
# Generate with: openssl rand -hex 32
SCHEDULER_SECRET=your-scheduler-secret-here

# ============================================================
# Web Push / VAPID Configuration (Notifications)
# ============================================================

# VAPID public key for Web Push notifications (base64 encoded)
# Generate with: npx web-push generate-vapid-keys
# The public key should be set NEXT_PUBLIC_ prefix for client-side use
NEXT_PUBLIC_VAPID_KEY=BIKn..."

# VAPID private key for Web Push notifications (SERVER-SIDE ONLY)
# Keep this secret! Never commit this to version control.
VAPID_PRIVATE_KEY=..."

# ============================================================
# Optional Google Analytics
# ============================================================

# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# Notes on Firebase Admin SDK (future use)
# ============================================================
# If you need to use Firebase Admin SDK on the server, you'll need:
# - FIREBASE_ADMIN_PROJECT_ID=your-project-id
# - FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# - FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Note: The private key MUST have \n for newlines, not actual line breaks!
# You can use a tool like `cert-sync` or format with proper escaping.