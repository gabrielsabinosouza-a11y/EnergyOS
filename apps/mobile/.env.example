# Use the computer's LAN IP when testing on a physical phone; localhost points to the phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Public Firebase client configuration for the existing EnergyOS project.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=energyos-bb7fd.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
