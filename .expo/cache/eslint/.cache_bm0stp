e is unavailable */ }\n  250 |     favoritesLoadedRef.current = true;\n  251 |   }, []);","@typescript-eslint/no-unused-vars","'notFound' is defined but never used.","Identifier","unusedVar",["2273"],"'badRequest' is defined but never used.",["2274"],["2275"],["2276"],["2277"],"'getFocusRoomByCode' is defined but never used.",["2278"],"'startFocusRoom' is defined but never used.",["2279"],"'endFocusRoom' is defined but never used.",["2280"],"'addParticipantToRoom' is defined but never used.",["2281"],"'getFocusRoomById' is defined but never used.",["2282"],"'FocusRoom' is defined but never used.",["2283"],"'RoomParticipant' is defined but never used.",["2284"],"'e' is defined but never used.","'deleteKanbanLabel' is defined but never used.",["2285"],"'AppError' is defined but never used.",["2286"],"'listInsights' is defined but never used.",["2287"],"'requireAuth' is defined but never used.",["2288"],"'request' is defined but never used.","'ensureUserBootstrap' is defined but never used.",["2289"],["2290"],"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/home/gabriel/Documentos/EnergyOS/src/app/configuracoes/page.tsx:60:59\n  58 |   const hasPassword = user?.providerData?.some((p) => p.providerId === \"password\") ?? false;\n  59 |\n> 60 |   const isDirty = JSON.stringify(form) !== JSON.stringify(savedRef.current);\n     |                                                           ^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  61 |\n  62 |   useEffect(() => {\n  63 |     if (!user) return;","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'user'. Either include it or remove the dependency array